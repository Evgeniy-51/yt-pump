<Window x:Class="YtPump.App.ProxySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:YtPump.App.Loc"
        xmlns:local="clr-namespace:YtPump.App"
        Title="{Binding [Settings], Source={x:Static loc:LocalizationService.Instance}}"
        Width="540"
        MinWidth="400"
        MinHeight="360"
        SizeToContent="Height"
        MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Canvas}"
        Icon="pack://application:,,,/Assets/ytpump.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}"
                               Text="{Binding [LanguageSection], Source={x:Static loc:LocalizationService.Instance}}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="SettingsUiLanguage"
                                     Margin="0,0,20,0"
                                     Content="{Binding [LanguageRussian], Source={x:Static loc:LocalizationService.Instance}}"
                                     IsChecked="{Binding IsRussian, Mode=TwoWay}" />
                        <RadioButton GroupName="SettingsUiLanguage"
                                     Content="{Binding [LanguageEnglish], Source={x:Static loc:LocalizationService.Instance}}"
                                     IsChecked="{Binding IsEnglish, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}"
                               Text="{Binding [ProxySection], Source={x:Static loc:LocalizationService.Instance}}" />

                    <StackPanel IsEnabled="{Binding IsFormEnabled}">
                        <Button HorizontalAlignment="Left"
                                Margin="0,0,0,12"
                                Command="{Binding BeginDraftCommand}"
                                Content="{Binding [ProxyNew], Source={x:Static loc:LocalizationService.Instance}}" />

                    <Border Margin="0,0,0,12"
                            Padding="12,10"
                            Background="{StaticResource Brush.SurfaceAlt}"
                            BorderBrush="{StaticResource Brush.Line}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding Draft}">
                            <TextBlock Style="{StaticResource Text.Section}"
                                       Margin="0,0,0,10"
                                       Text="{Binding [ProxyDraftTitle], Source={x:Static loc:LocalizationService.Instance}}" />
                            <local:ProxyProfileFields Margin="0,0,0,8" />
                            <TextBlock Foreground="{StaticResource Brush.Ink}"
                                       TextWrapping="Wrap"
                                       MinWidth="0"
                                       Margin="0,0,0,10"
                                       Text="{Binding StatusText}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Margin="0,0,8,0"
                                        Command="{Binding DataContext.TestProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding [ProxyTest], Source={x:Static loc:LocalizationService.Instance}}" />
                                <Button Style="{StaticResource Btn.Primary}"
                                        Margin="0,0,8,0"
                                        Command="{Binding DataContext.SaveProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding [ProxySave], Source={x:Static loc:LocalizationService.Instance}}" />
                                <Button Command="{Binding DataContext.CancelDraftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{Binding [ProxyCancel], Source={x:Static loc:LocalizationService.Instance}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ProxyProfileItem}">
                                <Border Margin="0,0,0,8"
                                        Padding="12,10"
                                        Background="{StaticResource Brush.SurfaceAlt}"
                                        BorderBrush="{StaticResource Brush.Line}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton VerticalAlignment="Top"
                                                     Margin="0,6,10,0"
                                                     IsChecked="{Binding IsActive, Mode=TwoWay}" />
                                        <Expander Grid.Column="1"
                                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <Expander.Header>
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Margin="12,0,0,0"
                                                               Foreground="{StaticResource Brush.InkMuted}"
                                                               Text="{Binding EndpointLabel}" />
                                                    <TextBlock Foreground="{StaticResource Brush.Ink}"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding HeaderTitle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Expander.Header>
                                            <StackPanel>
                                                <local:ProxyProfileFields Margin="0,0,0,8" />
                                                <TextBlock Foreground="{StaticResource Brush.Ink}"
                                                           TextWrapping="Wrap"
                                                           MinWidth="0"
                                                           Margin="0,0,0,10"
                                                           Text="{Binding StatusText}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Margin="0,0,8,0"
                                                            Command="{Binding DataContext.TestProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding [ProxyTest], Source={x:Static loc:LocalizationService.Instance}}" />
                                                    <Button Style="{StaticResource Btn.Primary}"
                                                            Margin="0,0,8,0"
                                                            Command="{Binding DataContext.SaveProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding [ProxySave], Source={x:Static loc:LocalizationService.Instance}}" />
                                                    <Button Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding [ProxyDelete], Source={x:Static loc:LocalizationService.Instance}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button HorizontalAlignment="Right"
                    IsCancel="True"
                    Click="Close_Click"
                    Content="{Binding [Close], Source={x:Static loc:LocalizationService.Instance}}" />
        </StackPanel>
    </ScrollViewer>
</Window>
