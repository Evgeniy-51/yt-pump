<Window x:Class="YtPump.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:YtPump.App.Loc"
        xmlns:local="clr-namespace:YtPump.App"
        mc:Ignorable="d"
        Title="{Binding [AppTitle], Source={x:Static loc:LocalizationService.Instance}}"
        Width="920"
        Height="640"
        MinWidth="520"
        MinHeight="400"
        Background="{StaticResource Brush.Canvas}"
        Icon="pack://application:,,,/Assets/ytpump.ico"
        Cursor="{Binding WindowCursor}"
        ForceCursor="{Binding IsBusy}">
    <Window.DataContext>
        <local:MainWindowViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="0,0,0,1"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource Switch}"
                              Content="{Binding [ProxyUse], Source={x:Static loc:LocalizationService.Instance}}"
                              IsChecked="{Binding ProxyEnabled}"
                              IsEnabled="{Binding IsFormEnabled}"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource Brush.Ink}"
                              FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ActiveProxyName}"
                               MaxWidth="220"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.InkMuted}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               ToolTip="{Binding ActiveProxyName}"
                               Visibility="{Binding ShowActiveProxyName, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Gear}"
                            Command="{Binding OpenHelpCommand}"
                            Margin="0,0,8,0"
                            ToolTip="{Binding [Help], Source={x:Static loc:LocalizationService.Instance}}">
                        <TextBlock Width="20"
                                   Height="25"
                                   Margin="0,-2,0,0"
                                   FontFamily="Segoe UI"
                                   FontSize="25"
                                   FontWeight="Black"
                                   LineHeight="25"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextAlignment="Center"
                                   Text="?"
                                   Foreground="{StaticResource Brush.Warm}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform Y="2" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource Btn.Gear}"
                            Command="{Binding OpenProxySettingsCommand}"
                            IsEnabled="{Binding IsFormEnabled}"
                            ToolTip="{Binding [Settings], Source={x:Static loc:LocalizationService.Instance}}">
                    <Path Width="20"
                          Height="20"
                          Stretch="Uniform"
                          Fill="{StaticResource Brush.Warm}"
                          Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16">
            <StackPanel>
                <Border Background="{StaticResource Brush.WarnBg}"
                        BorderBrush="{StaticResource Brush.WarnLine}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasMissingTools, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ToolsBannerText}"
                               Foreground="{StaticResource Brush.Ink}"
                               TextWrapping="Wrap"
                               MinWidth="0" />
                </Border>

                <Border Background="{StaticResource Brush.ErrBg}"
                        BorderBrush="{StaticResource Brush.ErrLine}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasSettingsWarning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SettingsBannerText}"
                               Foreground="{StaticResource Brush.Ink}"
                               TextWrapping="Wrap"
                               MinWidth="0" />
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Text="{Binding [UrlLabel], Source={x:Static loc:LocalizationService.Instance}}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      MinWidth="0"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      MaxDropDownHeight="240"
                                      IsEnabled="{Binding IsFormEnabled}"
                                      ItemsSource="{Binding RecentUrls}"
                                      Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                      LostFocus="UrlBox_LostFocus"
                                      SelectionChanged="UrlBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding ProbeCommand}" />
                                </ComboBox.InputBindings>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Style="{StaticResource Btn.FieldIcon}"
                                    Margin="8,0,0,0"
                                    IsEnabled="{Binding IsFormEnabled}"
                                    Command="{Binding PasteUrlCommand}"
                                    ToolTip="{Binding [Paste], Source={x:Static loc:LocalizationService.Instance}}"
                                    Content="&#xE77F;" />
                        </Grid>

                        <WrapPanel Margin="0,0,0,8">
                            <StackPanel Width="220" MinWidth="160" Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Text="{Binding [QualityLabel], Source={x:Static loc:LocalizationService.Instance}}" />
                                <ComboBox ItemsSource="{Binding QualityOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding QualityId}"
                                          IsEnabled="{Binding AreSelectorsEnabled}" />
                            </StackPanel>
                            <StackPanel Width="220" MinWidth="160" Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Text="{Binding [AudioLabel], Source={x:Static loc:LocalizationService.Instance}}" />
                                <ComboBox ItemsSource="{Binding AudioOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding AudioId}"
                                          IsEnabled="{Binding AreSelectorsEnabled}" />
                            </StackPanel>
                            <StackPanel Width="220" MinWidth="160" Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Text="{Binding [ContainerLabel], Source={x:Static loc:LocalizationService.Instance}}" />
                                <ComboBox ItemsSource="{Binding ContainerOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding ContainerId}"
                                          IsEnabled="{Binding IsFormEnabled}" />
                            </StackPanel>
                        </WrapPanel>

                        <CheckBox IsEnabled="{Binding IsSubtitlesEnabled}"
                                  Content="{Binding [Subtitles], Source={x:Static loc:LocalizationService.Instance}}"
                                  IsChecked="{Binding WriteSubtitles}" />
                        <ItemsControl ItemsSource="{Binding SubtitleChoices}"
                                      Margin="0,8,0,0"
                                      IsEnabled="{Binding IsSubtitlesEnabled}"
                                      Visibility="{Binding ShowSubtitleRadios, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding Code}"
                                                 Margin="0,0,14,4"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Checked="SubtitleLang_Checked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ComboBox ItemsSource="{Binding SubtitleChoices}"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding SubtitleLanguage}"
                                  MaxDropDownHeight="240"
                                  Margin="0,8,0,0"
                                  MinWidth="96"
                                  HorizontalAlignment="Left"
                                  IsEnabled="{Binding IsSubtitlesEnabled}"
                                  Visibility="{Binding ShowSubtitleCombo, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Text="{Binding [SaveToLabel], Source={x:Static loc:LocalizationService.Instance}}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     MinWidth="0"
                                     Style="{StaticResource TextBox.Display}"
                                     Text="{Binding OutputDirectory}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource Btn.FieldIcon}"
                                    Margin="8,0,0,0"
                                    IsEnabled="{Binding IsFormEnabled}"
                                    Command="{Binding BrowseFolderCommand}"
                                    ToolTip="{Binding [Browse], Source={x:Static loc:LocalizationService.Instance}}"
                                    Content="&#xE8B7;" />
                        </Grid>

                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Text="{Binding [FileNameLabel], Source={x:Static loc:LocalizationService.Instance}}" />
                        <TextBox x:Name="FileStemBox"
                                 MinWidth="0"
                                 IsEnabled="{Binding AreSelectorsEnabled}"
                                 Text="{Binding FileStem, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding [FileNameLabel], Source={x:Static loc:LocalizationService.Instance}}" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">
                            <Button Command="{Binding CancelCommand}"
                                    Margin="0,0,8,0"
                                    Content="{Binding [Cancel], Source={x:Static loc:LocalizationService.Instance}}" />
                            <Button Style="{StaticResource Btn.Primary}"
                                    Command="{Binding DownloadCommand}"
                                    Content="{Binding [Download], Source={x:Static loc:LocalizationService.Instance}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ProgressBar Minimum="0"
                             Maximum="100"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Value="{Binding Progress}"
                             Margin="0,0,0,8" />
                <TextBlock x:Name="StatusLine"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           MinWidth="0"
                           MinHeight="18"
                           Margin="0,0,0,10">
                    <TextBlock.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenFolderCommand}" />
                    </TextBlock.InputBindings>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.InkMuted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasOutputPath}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="TextDecorations" Value="Underline" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasOutputPath}" Value="True" />
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Warm}" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.ErrLine}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Style="{StaticResource Card}">
                    <Expander IsExpanded="{Binding IsLogExpanded}"
                              Header="{Binding [Log], Source={x:Static loc:LocalizationService.Instance}}">
                        <TextBox Style="{StaticResource TextBox.Log}"
                                 Margin="0,8,0,0"
                                 Text="{Binding LogText}" />
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
