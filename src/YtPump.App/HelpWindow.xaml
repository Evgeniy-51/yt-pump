<Window x:Class="YtPump.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:YtPump.App.Loc"
        Title="{Binding [Help], Source={x:Static loc:LocalizationService.Instance}}"
        Width="560"
        Height="560"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Canvas}"
        Icon="pack://application:,,,/Assets/ytpump.ico">
    <DockPanel Margin="16">
        <Button DockPanel.Dock="Bottom"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                IsCancel="True"
                Content="{Binding [Close], Source={x:Static loc:LocalizationService.Instance}}" />
        <Border Style="{StaticResource Card}">
            <FlowDocumentScrollViewer x:Name="Viewer"
                                      Background="Transparent"
                                      IsToolBarVisible="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto" />
        </Border>
    </DockPanel>
</Window>
